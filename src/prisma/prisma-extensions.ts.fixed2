import { PrismaClient } from '@prisma/client';

/**
 * Type for PaymentTransaction model attributes
 */
type PaymentTransactionAttributes = {
  userId: string;
  orderId: string;
  status: string;
  provider: string;
  amount: number;
  currency: string;
  transactionId: string;
  metadata?: Record<string, any>;
};

/**
 * Type for PaymentRefund model attributes
 */
type PaymentRefundAttributes = {
  paymentTransactionId: string;
  amount: number;
  currency: string;
  refundId: string;
  status: string;
  reason?: string;
  metadata?: Record<string, any>;
};

// Type for query parameters
type QueryParam = string | number | boolean | null;

/**
 * Type for OrderByInput options
 */
type OrderByInput = {
  [key: string]: 'asc' | 'desc';
};

/**
 * Custom client with payment transaction support 
 */
export class ExtendedPrismaClient extends PrismaClient {
  async findPaymentTransaction(args: { where: Record<string, any> }) {
    const { where } = args;
    if (where.transactionId) {
      const results = await this.$queryRaw<any[]>`
        SELECT * FROM "PaymentTransaction" WHERE "transactionId" = ${where.transactionId} LIMIT 1
      `;
      return results[0] || null;
    } else if (where.id) {
      const results = await this.$queryRaw<any[]>`
        SELECT * FROM "PaymentTransaction" WHERE "id" = ${where.id} LIMIT 1
      `;
      return results[0] || null;
    }
    return null;
  }

  async findManyPaymentTransactions(args: { 
    where?: Partial<PaymentTransactionAttributes>; 
    orderBy?: Record<string, 'asc' | 'desc'>; 
    skip?: number; 
    take?: number 
  }) {
    const { where, orderBy, skip, take } = args || {};
    let query = `SELECT * FROM "PaymentTransaction"`;
    
    const whereConditions: Array<string> = [];
    const params: Array<QueryParam> = [];
    
    // Build basic WHERE clause
    if (where) {
      if (where.userId) {
        whereConditions.push(`"userId" = $${params.length + 1}`);
        params.push(where.userId);
      }
      if (where.orderId) {
        whereConditions.push(`"orderId" = $${params.length + 1}`);
        params.push(where.orderId);
      }
      if (where.status) {
        whereConditions.push(`"status" = $${params.length + 1}`);
        params.push(where.status);
      }
      if (where.provider) {
        whereConditions.push(`"provider" = $${params.length + 1}`);
        params.push(where.provider);
      }
    }
    
    if (whereConditions.length > 0) {
      query += ` WHERE ${whereConditions.join(' AND ')}`;
    }
    
    // Ordering
    if (orderBy) {
      const orderByClauses: Array<string> = [];
      for (const [field, direction] of Object.entries(orderBy)) {
        orderByClauses.push(`"${field}" ${direction === 'desc' ? 'DESC' : 'ASC'}`);
      }
      if (orderByClauses.length > 0) {
        query += ` ORDER BY ${orderByClauses.join(', ')}`;
      }
    }
    
    // Pagination
    if (skip !== undefined) {
      query += ` OFFSET ${skip}`;
    }
    if (take !== undefined) {
      query += ` LIMIT ${take}`;
    }
    
    return await this.$queryRawUnsafe<any[]>(query, ...params);
  }

  async countPaymentTransactions(args: { where?: Partial<PaymentTransactionAttributes> }) {
    const { where } = args || {};
    let query = `SELECT COUNT(*) FROM "PaymentTransaction"`;
    
    const whereConditions: Array<string> = [];
    const params: Array<QueryParam> = [];
    
    if (where) {
      if (where.userId) {
        whereConditions.push(`"userId" = $${params.length + 1}`);
        params.push(where.userId);
      }
      if (where.orderId) {
        whereConditions.push(`"orderId" = $${params.length + 1}`);
        params.push(where.orderId);
      }
      if (where.status) {
        whereConditions.push(`"status" = $${params.length + 1}`);
        params.push(where.status);
      }
      if (where.provider) {
        whereConditions.push(`"provider" = $${params.length + 1}`);
        params.push(where.provider);
      }
    }
    
    if (whereConditions.length > 0) {
      query += ` WHERE ${whereConditions.join(' AND ')}`;
    }
    
    const result = await this.$queryRawUnsafe<Array<{count: string}>>(query, ...params);
    if (result && result.length > 0 && result[0]) {
      return Number(result[0].count);
    }
    return 0;
  }

  async createPaymentTransaction(args: { data: Partial<PaymentTransactionAttributes> }) {
    const { data } = args;
    const columns = Object.keys(data).map(k => `"${k}"`).join(', ');
    const placeholders = Object.keys(data).map((_, i) => `$${i + 1}`).join(', ');
    const values = Object.values(data);
    
    const query = `
      INSERT INTO "PaymentTransaction" (${columns})
      VALUES (${placeholders})
      RETURNING *
    `;
    
    const result = await this.$queryRawUnsafe<any[]>(query, ...values);
    if (result && result.length > 0) {
      return result[0];
    }
    return null;
  }

  async updatePaymentTransaction(args: { where: Record<string, any>; data: Partial<PaymentTransactionAttributes> }) {
    const { where, data } = args;
    
    // Build the SET part
    const updateSet = Object.entries(data)
      .map(([key, value], index) => {
        if (key === 'metadata' && typeof value === 'object') {
          return `"${key}" = $${index + 1}::jsonb`;
        }
        return `"${key}" = $${index + 1}`;
      })
      .join(', ');
    
    const values = Object.values(data);
    
    // Build the WHERE clause
    let whereClause = '';
    if (where.id) {
      whereClause = `WHERE "id" = $${values.length + 1}`;
      values.push(where.id);
    } else if (where.transactionId) {
      whereClause = `WHERE "transactionId" = $${values.length + 1}`;
      values.push(where.transactionId);
    }
    
    const query = `
      UPDATE "PaymentTransaction"
      SET ${updateSet}
      ${whereClause}
      RETURNING *
    `;
    
    const result = await this.$queryRawUnsafe<any[]>(query, ...values);
    if (result && result.length > 0) {
      return result[0];
    }
    return null;
  }

  async createPaymentRefund(args: { data: Partial<PaymentRefundAttributes> }) {
    const { data } = args;
    const columns = Object.keys(data).map(k => `"${k}"`).join(', ');
    const placeholders = Object.keys(data).map((_, i) => `$${i + 1}`).join(', ');
    const values = Object.values(data);
    
    const query = `
      INSERT INTO "PaymentRefund" (${columns})
      VALUES (${placeholders})
      RETURNING *
    `;
    
    const result = await this.$queryRawUnsafe<any[]>(query, ...values);
    if (result && result.length > 0) {
      return result[0];
    }
    return null;
  }

  async updatePaymentRefund(args: { where: Record<string, any>; data: Partial<PaymentRefundAttributes> }) {
    const { where, data } = args;
    
    // Build the SET part
    const updateSet = Object.entries(data)
      .map(([key, value], index) => `"${key}" = $${index + 1}`)
      .join(', ');
    
    const values = Object.values(data);
    
    // Build the WHERE clause
    let whereClause = '';
    if (where.id) {
      whereClause = `WHERE "id" = $${values.length + 1}`;
      values.push(where.id);
    } else if (where.refundId) {
      whereClause = `WHERE "refundId" = $${values.length + 1}`;
      values.push(where.refundId);
    } else if (where.paymentTransactionId) {
      whereClause = `WHERE "paymentTransactionId" = $${values.length + 1}`;
      values.push(where.paymentTransactionId);
    }
    
    const query = `
      UPDATE "PaymentRefund"
      SET ${updateSet}
      ${whereClause}
      RETURNING *
    `;
    
    const result = await this.$queryRawUnsafe<any[]>(query, ...values);
    if (result && result.length > 0) {
      return result[0];
    }
    return null;
  }

  async aggregatePaymentRefunds(args: { where?: Partial<PaymentRefundAttributes>; _sum?: Record<string, boolean> }) {
    const { where, _sum } = args;
    
    let selectClause = 'COUNT(*)';
    if (_sum && _sum.amount) {
      selectClause = 'SUM(amount)';
    }
    
    let whereClause = '';
    const values: Array<QueryParam> = [];
    if (where && where.paymentTransactionId) {
      whereClause = `WHERE "paymentTransactionId" = $1`;
      values.push(where.paymentTransactionId);
    }
    
    const query = `
      SELECT ${selectClause} as result
      FROM "PaymentRefund"
      ${whereClause}
    `;
    
    const result = await this.$queryRawUnsafe<Array<{result: string}>>(query, ...values);
    
    // Expected format for aggregate result
    if (result && result.length > 0 && result[0]) {
      if (_sum && _sum.amount) {
        return {
          _sum: {
            amount: Number(result[0].result) || 0
          }
        };
      }
      
      return {
        _count: Number(result[0].result)
      };
    }
    
    // Return default values if no result
    if (_sum && _sum.amount) {
      return {
        _sum: {
          amount: 0
        }
      };
    }
    
    return {
      _count: 0
    };
  }
}

/**
 * Creates and extends a Prisma client for payment transactions
 */
export function extendPrismaClient(): ExtendedPrismaClient {
  return new ExtendedPrismaClient();
}