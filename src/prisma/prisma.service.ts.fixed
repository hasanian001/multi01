import { Injectable, OnModuleInit, OnModuleDestroy } from '@nestjs/common';
import { PrismaClient } from '@prisma/client';
import { ExtendedPrismaClient, extendPrismaClient } from './prisma-extensions';

@Injectable()
export class PrismaService implements OnModuleInit, OnModuleDestroy {
  // Extended client with custom models
  private extendedClient: ExtendedPrismaClient;

  constructor() {
    // Create extended client
    this.extendedClient = extendPrismaClient();
  }
  
  // Forward methods to extended client
  $connect() {
    return this.extendedClient.$connect();
  }
  
  $disconnect() {
    return this.extendedClient.$disconnect();
  }
  
  // Expose prisma models
  get user() {
    return this.extendedClient.user;
  }
  
  get shop() {
    return this.extendedClient.shop;
  }
  
  get product() {
    return this.extendedClient.product;
  }
  
  get category() {
    return this.extendedClient.category;
  }
  
  get brand() {
    return this.extendedClient.brand;
  }
  
  get order() {
    return this.extendedClient.order;
  }
  
  get orderItem() {
    return this.extendedClient.orderItem;
  }
  
  get wishlist() {
    return this.extendedClient.wishlist;
  }
  
  get session() {
    return this.extendedClient.session;
  }
  
  // Custom methods for payment transactions
  async findPaymentTransaction(args: { where: Record<string, any> }) {
    return this.extendedClient.findPaymentTransaction(args);
  }
  
  async findManyPaymentTransactions(args: any) {
    return this.extendedClient.findManyPaymentTransactions(args);
  }
  
  async countPaymentTransactions(args: any) {
    return this.extendedClient.countPaymentTransactions(args);
  }
  
  async createPaymentTransaction(args: any) {
    return this.extendedClient.createPaymentTransaction(args);
  }
  
  async updatePaymentTransaction(args: any) {
    return this.extendedClient.updatePaymentTransaction(args);
  }
  
  async createPaymentRefund(args: any) {
    return this.extendedClient.createPaymentRefund(args);
  }
  
  async updatePaymentRefund(args: any) {
    return this.extendedClient.updatePaymentRefund(args);
  }
  
  async aggregatePaymentRefunds(args: any) {
    return this.extendedClient.aggregatePaymentRefunds(args);
  }
  
  // Add shorthand accessor methods for payment operations
  get paymentTransaction() {
    return {
      findUnique: (args: any) => this.findPaymentTransaction(args),
      findMany: (args: any) => this.findManyPaymentTransactions(args),
      count: (args: any) => this.countPaymentTransactions(args),
      create: (args: any) => this.createPaymentTransaction(args),
      update: (args: any) => this.updatePaymentTransaction(args)
    };
  }
  
  get paymentRefund() {
    return {
      create: (args: any) => this.createPaymentRefund(args),
      update: (args: any) => this.updatePaymentRefund(args),
      aggregate: (args: any) => this.aggregatePaymentRefunds(args)
    };
  }
  
  // Helper method to execute raw queries
  $queryRaw<T = unknown>(...args: any[]) {
    return this.extendedClient.$queryRaw<T>(...args);
  }
  
  $queryRawUnsafe<T = unknown>(...args: any[]) {
    return this.extendedClient.$queryRawUnsafe<T>(...args);
  }

  async onModuleInit() {
    await this.$connect();
  }

  async onModuleDestroy() {
    await this.$disconnect();
  }

  async cleanDatabase() {
    if (process.env.NODE_ENV === 'production') {
      return;
    }
    
    // Get all model names in a type-safe way
    const models = [
      'user',
      'shop',
      'product',
      'category',
      'brand',
      'order',
      'orderItem',
      'wishlist',
      'session'
    ];
    
    // Delete all records from each model
    return Promise.all(
      models.map(modelName => this[modelName as keyof this].deleteMany({}))
    );
  }
}