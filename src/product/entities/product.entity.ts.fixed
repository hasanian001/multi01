import { ObjectType, Field, ID, Float } from '@nestjs/graphql';
import { Shop } from '../../shop/entities/shop.entity';
import { Category } from '../../category/entities/category.entity';
import { Brand } from '../../brand/entities/brand.entity';

@ObjectType()
export class Product {
  @Field(() => ID)
  id: string | number;

  @Field()
  name: string;

  @Field()
  slug: string;

  @Field({ nullable: true })
  description?: string | null;

  @Field(() => ID)
  shopId: string | number;

  @Field(() => Shop, { nullable: true })
  shop?: Shop | any;

  @Field(() => ID)
  categoryId: string | number;

  @Field(() => Category, { nullable: true })
  category?: Category;

  @Field(() => ID, { nullable: true })
  subCategoryId?: string | number | null;

  @Field(() => ID, { nullable: true })
  brandId?: string | number | null;

  @Field(() => Brand, { nullable: true })
  brand?: Brand;

  @Field(() => Float)
  price: number;

  @Field(() => Float, { nullable: true })
  sale_price?: number | null;

  @Field({ nullable: true })
  sku?: string | null;

  @Field()
  stock: number;

  @Field()
  is_featured: boolean;

  @Field()
  is_published: boolean;

  @Field(() => [String])
  images: string[];

  @Field()
  created_at: Date;

  @Field()
  updated_at: Date;
  
  @Field({ nullable: true })
  deleted_at?: Date | null;
  
  // Additional properties to support schema compatibility
  seller?: any; // Support for legacy seller field
  quantity?: number; // Alternative to stock
  featured?: boolean; // Alternative to is_featured
  published?: boolean; // Alternative to is_published
  sellerId?: string | number; // Alternative to shopId
}

@ObjectType()
export class ProductResponse {
  @Field(() => Product, { nullable: true })
  product?: Product | null;

  @Field()
  success: boolean;

  @Field()
  message: string;
}

@ObjectType()
export class ProductsResponse {
  @Field(() => [Product])
  products: Product[];

  @Field()
  success: boolean;

  @Field()
  message: string;

  @Field()
  count: number;
}