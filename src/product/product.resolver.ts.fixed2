import { Resolver, Query, Mutation, Args, Int } from '@nestjs/graphql';
import { ProductService } from './product.service';
import { Product, ProductResponse, ProductsResponse } from './entities/product.entity';
import { CreateProductInput, UpdateProductInput, ProductFilterInput } from './dto/product.dto';
import { UseGuards } from '@nestjs/common';
import { AuthGuard } from '../auth/auth.guard';
import { RolesGuard } from '../auth/roles.guard';
import { Roles } from '../auth/decorators/roles.decorator';
import { CurrentUser } from '../auth/decorators/current-user.decorator';

@Resolver(() => Product)
export class ProductResolver {
  constructor(private readonly productService: ProductService) {}

  @Query(() => ProductsResponse)
  async products(
    @Args('filterInput', { nullable: true }) filterInput?: ProductFilterInput,
  ): Promise<ProductsResponse> {
    const result = await this.productService.findAll(filterInput || {});
    
    // Ensure all products match the Product entity structure
    const products = result.products.map(product => {
      // Extract seller ID for shop ID
      const sellerId = product.seller?.id || 
                       (product.sellerId ? product.sellerId : '0');
      
      return {
        ...product,
        id: typeof product.id === 'string' ? parseInt(product.id, 10) : product.id,
        shopId: typeof sellerId === 'string' ? parseInt(sellerId, 10) : sellerId,
        categoryId: typeof product.categoryId === 'string' ? parseInt(product.categoryId, 10) : product.categoryId,
        brandId: typeof product.brandId === 'string' ? parseInt(product.brandId, 10) : product.brandId,
        slug: product.slug || '',
        stock: product.quantity || 0,
        is_featured: product.featured || false,
        is_published: product.published || false
      };
    });
    
    return {
      products,
      count: result.count,
      success: result.success,
      message: result.message
    };
  }

  @Query(() => ProductResponse)
  async product(
    @Args('id', { type: () => Int }) id: number,
  ): Promise<ProductResponse> {
    const result = await this.productService.findOne(id.toString());
    
    if (!result.product) {
      return {
        product: null,
        success: result.success,
        message: result.message
      };
    }
    
    // Extract seller ID for shop ID
    const sellerId = result.product.seller?.id || 
                    (result.product.sellerId ? result.product.sellerId : '0');
    
    // Convert the product object to the expected Product type
    const product = {
      ...result.product,
      id: typeof result.product.id === 'string' ? parseInt(result.product.id, 10) : result.product.id,
      shopId: typeof sellerId === 'string' ? parseInt(sellerId, 10) : sellerId,
      categoryId: typeof result.product.categoryId === 'string' ? parseInt(result.product.categoryId, 10) : result.product.categoryId,
      brandId: typeof result.product.brandId === 'string' ? parseInt(result.product.brandId, 10) : result.product.brandId,
      slug: result.product.slug || '',
      stock: result.product.quantity || 0,
      is_featured: result.product.featured || false,
      is_published: result.product.published || false
    };
    
    return {
      product,
      success: result.success,
      message: result.message
    };
  }

  @Query(() => ProductsResponse)
  async shopProducts(
    @Args('shopId', { type: () => Int }) shopId: number,
    @Args('filterInput', { nullable: true }) filterInput?: Omit<ProductFilterInput, 'shopId'>,
  ): Promise<ProductsResponse> {
    const result = await this.productService.findByShop(shopId.toString(), filterInput || {});
    
    // Ensure all products match the Product entity structure
    const products = result.products.map(product => {
      // Extract seller ID for shop ID
      const sellerId = product.seller?.id || 
                       (product.sellerId ? product.sellerId : '0');
      
      return {
        ...product,
        id: typeof product.id === 'string' ? parseInt(product.id, 10) : product.id,
        shopId: typeof sellerId === 'string' ? parseInt(sellerId, 10) : sellerId,
        categoryId: typeof product.categoryId === 'string' ? parseInt(product.categoryId, 10) : product.categoryId,
        brandId: typeof product.brandId === 'string' ? parseInt(product.brandId, 10) : product.brandId,
        slug: product.slug || '',
        stock: product.quantity || 0,
        is_featured: product.featured || false,
        is_published: product.published || false
      };
    });
    
    return {
      products,
      count: result.count,
      success: result.success,
      message: result.message
    };
  }

  @Mutation(() => ProductResponse)
  @UseGuards(AuthGuard, RolesGuard)
  @Roles('SELLER', 'ADMIN')
  async createProduct(
    @Args('createProductInput') createProductInput: CreateProductInput,
    @CurrentUser() user,
  ): Promise<ProductResponse> {
    const result = await this.productService.create(createProductInput, user);
    
    if (!result.product) {
      return {
        product: null,
        success: result.success,
        message: result.message
      };
    }
    
    // Extract seller ID for shop ID
    const sellerId = result.product.seller?.id || 
                    (result.product.sellerId ? result.product.sellerId : '0');
    
    // Convert the product object to the expected Product type
    const product = {
      ...result.product,
      id: typeof result.product.id === 'string' ? parseInt(result.product.id, 10) : result.product.id,
      shopId: typeof sellerId === 'string' ? parseInt(sellerId, 10) : sellerId,
      categoryId: typeof result.product.categoryId === 'string' ? parseInt(result.product.categoryId, 10) : result.product.categoryId,
      brandId: typeof result.product.brandId === 'string' ? parseInt(result.product.brandId, 10) : result.product.brandId,
      slug: result.product.slug || '',
      stock: result.product.quantity || 0,
      is_featured: result.product.featured || false,
      is_published: result.product.published || false
    };
    
    return {
      product,
      success: result.success,
      message: result.message
    };
  }

