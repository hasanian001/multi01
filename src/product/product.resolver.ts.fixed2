      categoryId: typeof result.product.categoryId === 'string' ? parseInt(result.product.categoryId, 10) : result.product.categoryId,
      brandId: typeof result.product.brandId === 'string' ? parseInt(result.product.brandId, 10) : result.product.brandId,
      slug: result.product.slug || '',
      stock: result.product.quantity || 0,
