  @Mutation(() => ProductResponse)
  @UseGuards(AuthGuard, RolesGuard)
  @Roles('SELLER', 'ADMIN')
  async deleteProduct(
    @Args('id', { type: () => Int }) id: number,
    @CurrentUser() user,
  ): Promise<ProductResponse> {
    const result = await this.productService.remove(id.toString(), user);
    
    if (!result.product) {
      return {
        product: null,
        success: result.success,
        message: result.message
