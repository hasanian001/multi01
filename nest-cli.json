{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "compilerOptions": {
    "deleteOutDir": true,
    "excludeFiles": ["**/temp/**/*", "**/excluded-folder/**/*"],
    "exclude": ["node_modules", "dist", "test", "temp"]
  }
}
